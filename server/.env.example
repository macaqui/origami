# Servidor
PORT=3001

# Orígenes permitidos por CORS, separados por coma.
# Déjalo vacío para permitir cualquier origen (solo recomendado en desarrollo local).
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL / MariaDB
# Si en Windows aparece "Access denied for user 'origami'", cambia este valor
# a 127.0.0.1: el script database.sql crea el usuario para los dos hosts.
DB_HOST=localhost
DB_USER=origami
DB_PASSWORD=origami123
DB_NAME=origami_db
