# Servidor
PORT=3001

# Orígenes permitidos por CORS, separados por coma.
# Déjalo vacío para permitir cualquier origen (solo recomendado en desarrollo local).
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL / MariaDB, en el formato de conexión que usa Prisma:
#   mysql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS
#
# Si en Windows aparece "Access denied for user 'origami'", cambia localhost por
# 127.0.0.1: el script database.sql crea el usuario para los dos hosts.
DATABASE_URL="mysql://origami:origami123@localhost:3306/origami_db"
