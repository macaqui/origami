# Servidor
PORT=3001

# Orígenes permitidos por CORS, separados por coma.
# Déjalo vacío para permitir cualquier origen (solo recomendado en desarrollo local).
CORS_ORIGIN=http://localhost:5173

# Base de datos SQLite: un archivo dentro de server/prisma.
# No hace falta instalar ni arrancar ningún servidor de base de datos.
# El archivo (dev.db) se crea con:  npx prisma db push
DATABASE_URL="file:./dev.db"
