# URL base de la API del backend (Express).
# Copia este archivo a `.env` y ajústalo si el backend corre en otro puerto o dominio.
#
# Si Express sirve también la interfaz compilada (un solo servicio), se usa la
# ruta relativa:
#   VITE_API_URL=/api/hojas
VITE_API_URL=http://localhost:3001/api/hojas
